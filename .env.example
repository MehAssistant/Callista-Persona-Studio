# ==========================================
# CALLISTA PERSONA STUDIO - ENVIRONMENT CONFIG
# ==========================================

# Port server HTTP (default: 3000)
PORT=3000

# Lingkungan aplikasi: development | production | test
NODE_ENV=development

# Nama aplikasi
APP_NAME=Callista Persona Studio

# Prefix URL untuk REST API
API_PREFIX=/api

# Nama persona bot (default: Callista)
PERSONA_NAME=Callista

# ==========================================
# WHATSAPP WEB CONFIGURATION
# ==========================================

# Direktori penyimpanan sesi WhatsApp (LocalAuth)
WA_SESSION_PATH=./sessions

# Identifier sesi client WhatsApp
WA_CLIENT_ID=callista-bot

# Mode headless Puppeteer (true | false)
PUPPETEER_HEADLESS=true

# Masa berlaku QR code dalam milidetik (default: 60000 / 60 detik)
WA_QR_TIMEOUT_MS=60000

# ==========================================
# GOOGLE CLOUD VERTEX AI - EXPRESS MODE
# ==========================================

# API Key Google Cloud untuk Vertex AI Express Mode
# Masukkan API Key Anda di file .env (JANGAN commit ke git)
GOOGLE_API_KEY=your_google_api_key_here

# Google Cloud Project ID (default: third-yeti-7cb1c)
GOOGLE_CLOUD_PROJECT=third-yeti-7cb1c

# Model Vertex AI (default: gemini-2.5-flash)
VERTEX_AI_MODEL=gemini-2.5-flash
